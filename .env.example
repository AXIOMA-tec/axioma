# Copia este archivo a ".env" (sin el ".example") y rellena tus propios
# valores. ".env" nunca se sube a Git — este archivo sí, para que el equipo
# sepa qué variables existen.

MONGO_URI=mongodb://localhost:27017/axioma
JWT_SECRET=reemplaza-esto-con-una-cadena-aleatoria-larga
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Registro / inicio de sesión con Google (opcional: sin estas dos, el botón
# de Google simplemente no aparece). Es el MISMO "Client ID" en ambas —
# una la lee el backend (para verificar tokens) y la otra el frontend (para
# dibujar el botón). No es secreto; el "client secret" NO se usa ni se pone
# aquí. Ver README, sección "Iniciar sesión con Google".
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Subir pósters de eventos desde /admin/eventos (opcional: sin estas dos, el
# panel deja crear/editar eventos igual, solo sin subir imagen — se ven con
# su fecha en grande). Cuenta gratis en https://cloudinary.com; el "cloud
# name" está en el dashboard, y el preset se crea en Settings → Upload →
# Upload presets → Add upload preset → Signing Mode: "Unsigned". Ninguno de
# los dos es secreto (por eso ambos llevan VITE_: van al navegador). Ver
# src/lib/cloudinary.js.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
